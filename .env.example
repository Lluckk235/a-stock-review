# A股收盘复盘 — 推送凭证（仅本地，勿提交到任何仓库）

# iOS Bark（主通道，沙箱自动推）
BARK_KEY=

# 可选：自建 Bark 服务器地址（默认官方 https://api.day.app）
# BARK_SERVER=https://api.day.app

# 可选：微信推送 WxPusher（沙箱推不出，需本机运行）
# WXPUSHER_APP_TOKEN=
# WXPUSHER_UIDS=

# 可选：企业微信群机器人
# WECOM_WEBHOOK_URL=

# 可选：GitHub Pages 在线链接前缀（GitHub Actions 自动注入，本地不用填）
# PAGES_BASE_URL=https://YOUR_USERNAME.github.io/a-stock-review
